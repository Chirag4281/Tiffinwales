<dict>
    <key>app_id</key>
    <string>1be25b22-5e27-418f-8c0a-9a68cc6c39e5</string>
    <key>notification_priority</key>
    <string>high</string>
</dict>
	<!-- Google Sign-In Configuration (if using) -->

	<!-- App Transport Security -->
	<key>NSAppTransportSecurity</key>
<dict>
    <key>NSExceptionDomains</key>
    <dict>
        <key>quantorra.co</key>
        <dict>
            <key>NSExceptionAllowsInsecureHTTPLoads</key>
            <true/>
            <key>NSIncludesSubdomains</key>
            <true/>
        </dict>
    </dict>
</dict>

