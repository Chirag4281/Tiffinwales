	<key>NSCameraUsageDescription</key>
	<string>We need camera access to upload profile pictures and menu images</string>

	<key>NSPhotoLibraryUsageDescription</key>
	<string>We need photo library access to upload images for menu items and profile</string>

	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>We need permission to save images to your photo library</string>

